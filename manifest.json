{
  "manifest_version": 3,
  "name": "Hover Translate",
  "version": "1.5.0",
  "description": "Point at any text or image, tap Ctrl, and read it in your language. Free, no account, no API key.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://translate-pa.googleapis.com/*",
    "https://translate.googleapis.com/*",
    "https://transmart.qq.com/*",
    "https://api.mymemory.translated.net/*",
    "https://translate.yandex.net/*",
    "https://lensfrontend-pa.googleapis.com/*",
    "https://aidemo.youdao.com/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "src/content/loader.js"
      ],
      "css": [
        "src/styles/content.css"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/*.js",
        "src/engine/*.js",
        "src/lib/*.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "128": "icons/128.png"
  }
}
